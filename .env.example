# Cloudflare & Vercel Environment Variables
# Configured in Vercel Project Settings > Environment Variables

# --- Cloudflare R2 Object Storage (S3-Compatible API) ---
CF_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CF_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
CF_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
R2_BUCKET_NAME=yaratul-media

# --- Cloudflare Management API v4 ---
CF_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
CF_API_TOKEN=<CLOUDFLARE_SCOPED_API_TOKEN>
CF_GLOBAL_API_KEY=<CLOUDFLARE_GLOBAL_API_KEY>
CF_ZONE_ID=<OPTIONAL_ZONE_ID_FOR_YARATUL_COM>
CF_EMAIL=owner@yaratul.com

# --- Optional Security & Routing ---
PURGE_SECRET=<OPTIONAL_BEARER_TOKEN_FOR_CACHE_PURGE>
